<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🌄 Andes Observatorio</title>
    
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            background: linear-gradient(135deg, #e8f0fe 0%, #d4e4f7 100%);
            min-height: 100vh;
            padding: 20px;
        }
        .container { max-width: 1400px; margin: 0 auto; }
        .header {
            background: linear-gradient(135deg, #1a3a5c 0%, #2c5f8a 100%);
            color: white;
            padding: 20px 30px;
            border-radius: 15px;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 4px 20px rgba(26, 58, 92, 0.3);
        }
        .header h1 { font-size: 28px; display: flex; align-items: center; gap: 10px; }
        .header-info {
            display: flex;
            align-items: center;
            gap: 20px;
            font-size: 14px;
        }
        .status-badge {
            background: #2ecc71;
            color: white;
            padding: 5px 15px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.7; }
            100% { opacity: 1; }
        }
        .card {
            background: white;
            border-radius: 16px;
            padding: 20px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }
        .card-title {
            background: linear-gradient(135deg, #1a3a5c 0%, #2c5f8a 100%);
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            margin: -5px -5px 15px -5px;
            font-size: 16px;
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        #map { height: 400px; border-radius: 8px; }
        #chart-container { height: 300px; position: relative; }
        .controls {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-bottom: 15px;
        }
        .controls label { font-weight: bold; }
        .controls select, .controls input {
            padding: 8px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 14px;
        }
        .controls button {
            padding: 8px 20px;
            background: #2c5f8a;
            color: white;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }
        .controls button:hover { background: #1a3a5c; }
        .footer {
            text-align: center;
            padding: 20px;
            color: #95a5a6;
            font-size: 13px;
            border-top: 1px solid #d4e4f7;
            margin-top: 30px;
        }
        @media (max-width: 768px) {
            .header { flex-direction: column; gap: 10px; text-align: center; }
            .header h1 { font-size: 22px; }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🌄 Andes Observatorio</h1>
            <div class="header-info">
                <span id="update-time">🔄 Actualizando...</span>
                <span class="status-badge">● En Vivo</span>
            </div>
        </div>

        <!-- Mapa -->
        <div class="card">
            <div class="card-title">🗺️ Estaciones SIRGAS</div>
            <div id="map"></div>
        </div>

        <!-- Datos Troposféricos SIRGAS -->
        <div class="card">
            <div class="card-title">🛰️ Retardo Troposférico Cenital (ZTD) - SIRGAS</div>
            <div class="controls">
                <div style="flex:1;min-width:200px;">
                    <label for="estacion-select">Seleccionar estación:</label>
                    <select id="estacion-select" style="width:100%;">
                        <option value="">Cargando estaciones...</option>
                    </select>
                </div>
                <div style="flex:1;min-width:200px;">
                    <label>Rango de fechas:</label>
                    <div style="display:flex;gap:10px;margin-top:5px;">
                        <input type="date" id="fecha-desde" style="flex:1;">
                        <input type="date" id="fecha-hasta" style="flex:1;">
                    </div>
                </div>
                <div style="display:flex;align-items:flex-end;">
                    <button id="actualizar-grafico">Actualizar Gráfico</button>
                </div>
            </div>
            <div id="chart-container">
                <canvas id="ztd-chart"></canvas>
            </div>
            <div id="ztd-info" style="margin-top:10px;font-size:12px;color:#95a5a6;text-align:center;">
                Selecciona una estación y rango de fechas para visualizar la serie de ZTD
            </div>
        </div>
    </div>

    <div class="footer">
        🌄 Andes Observatorio v2.0 | Datos SIRGAS y OpenWeatherMap | Actualización automática
    </div>

    <script>
        let map = null;
        let ztdChart = null;

        // ===== INICIALIZAR MAPA =====
        function initMap() {
            map = L.map('map').setView([-15, -70], 4);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);
        }

        // ===== GRÁFICO ZTD (SIRGAS) =====
        async function cargarEstacionesTropo() {
            try {
                const response = await fetch('http://localhost:8001/api/v1/geodesia/tropo/estaciones');
                if (!response.ok) throw new Error('Error al cargar estaciones');
                const data = await response.json();
                
                const select = document.getElementById('estacion-select');
                select.innerHTML = '<option value="">Selecciona una estación...</option>';
                
                if (data.estaciones && data.estaciones.length > 0) {
                    data.estaciones.forEach(est => {
                        const option = document.createElement('option');
                        option.value = est.codigo;
                        option.textContent = `${est.codigo} (${est.total_registros} registros)`;
                        select.appendChild(option);
                    });
                    // Cargar automáticamente la primera estación
                    if (data.estaciones.length > 0) {
                        select.value = data.estaciones[0].codigo;
                        actualizarGraficoZTD();
                    }
                } else {
                    select.innerHTML = '<option value="">No hay estaciones disponibles</option>';
                }
            } catch (error) {
                console.error('Error cargando estaciones:', error);
                document.getElementById('estacion-select').innerHTML = '<option value="">Error al cargar</option>';
            }
        }

        async function actualizarGraficoZTD() {
            const codigo = document.getElementById('estacion-select').value;
            if (!codigo) {
                alert('Por favor, selecciona una estación');
                return;
            }
            
            const desde = document.getElementById('fecha-desde').value;
            const hasta = document.getElementById('fecha-hasta').value;
            
            let url = `http://localhost:8001/api/v1/geodesia/tropo/${codigo}/serie?limite=500`;
            if (desde) url += `&desde=${desde}`;
            if (hasta) url += `&hasta=${hasta}`;
            
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error('Error al cargar datos');
                const data = await response.json();
                
                if (!data.datos || data.datos.length === 0) {
                    document.getElementById('ztd-info').textContent = `⚠️ No hay datos para ${codigo} en el rango seleccionado`;
                    return;
                }
                
                // Preparar datos para el gráfico
                const fechas = data.datos.map(d => new Date(d.fecha).toLocaleDateString());
                const valores = data.datos.map(d => d.valor);
                const errores = data.datos.map(d => d.error || 0);
                
                // Actualizar información
                document.getElementById('ztd-info').innerHTML = `
                    📊 Estación: <strong>${data.estacion}</strong> | 
                    Registros: <strong>${data.total_registros}</strong> | 
                    Rango: ${fechas[0]} a ${fechas[fechas.length-1]}
                `;
                
                // Crear o actualizar gráfico
                const ctx = document.getElementById('ztd-chart').getContext('2d');
                
                if (ztdChart) {
                    ztdChart.destroy();
                }
                
                ztdChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: fechas,
                        datasets: [{
                            label: 'ZTD (metros)',
                            data: valores,
                            borderColor: '#2c5f8a',
                            backgroundColor: 'rgba(44, 95, 138, 0.1)',
                            tension: 0.3,
                            fill: true,
                            pointRadius: 1,
                            pointHoverRadius: 5
                        }, {
                            label: 'Error ZTD',
                            data: errores,
                            borderColor: '#e74c3c',
                            backgroundColor: 'rgba(231, 76, 60, 0.1)',
                            tension: 0.3,
                            borderDash: [5, 5],
                            pointRadius: 0,
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(context) {
                                        return `${context.dataset.label}: ${context.parsed.y.toFixed(4)} m`;
                                    }
                                }
                            }
                        },
                        scales: {
                            y: {
                                title: { display: true, text: 'ZTD (metros)' },
                                grid: { color: 'rgba(0,0,0,0.05)' }
                            },
                            x: {
                                title: { display: true, text: 'Fecha' },
                                ticks: { maxTicksLimit: 20 },
                                grid: { display: false }
                            }
                        }
                    }
                });
                
            } catch (error) {
                console.error('Error actualizando gráfico:', error);
                document.getElementById('ztd-info').textContent = `❌ Error: ${error.message}`;
            }
        }

        // ===== INICIALIZACIÓN =====
        document.addEventListener('DOMContentLoaded', () => {
            initMap();
            
            // Configurar fechas por defecto (últimos 30 días)
            const hoy = new Date();
            const hace30Dias = new Date(hoy);
            hace30Dias.setDate(hace30Dias.getDate() - 30);
            
            document.getElementById('fecha-desde').value = hace30Dias.toISOString().split('T')[0];
            document.getElementById('fecha-hasta').value = hoy.toISOString().split('T')[0];
            
            // Cargar estaciones
            cargarEstacionesTropo();
            
            // Eventos
            document.getElementById('actualizar-grafico').addEventListener('click', actualizarGraficoZTD);
            document.getElementById('estacion-select').addEventListener('change', () => {
                if (document.getElementById('estacion-select').value) {
                    actualizarGraficoZTD();
                }
            });
            
            // Actualizar hora
            document.getElementById('update-time').textContent = '🔄 ' + new Date().toLocaleTimeString();
            setInterval(() => {
                document.getElementById('update-time').textContent = '🔄 ' + new Date().toLocaleTimeString();
            }, 60000);
        });
    </script>
</body>
</html>
